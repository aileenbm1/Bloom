# BLOOM no usa archivos .env en producción.
# Los secretos se guardan cifrados en Cloudflare con:
#   npm run secret:set          (genera y guarda APP_SECRET)
#
# Variables NO secretas (se editan en wrangler.jsonc → "vars"):
#   BUSINESS_NAME=BLOOM
#   WHATSAPP_NUMBER=5215512345678   # solo dígitos, con código de país
#
# Opcional, solo para automatizar pruebas locales de create-admin (no lo uses en producción):
# BLOOM_ADMIN_PASSWORD=
#
# Para Wrangler en CI (no en esta computadora): crea un API Token con permisos de Workers y D1
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
