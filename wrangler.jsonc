{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Nombre del Worker: forma parte de la URL pública
  // https://bloom-cuentas.<tu-subdominio>.workers.dev
  "name": "bloom-cuentas",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // El Worker procesa primero cada petición para aplicar encabezados de seguridad.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bloom-db",
      // Sustituye por el ID real que imprime: npx wrangler d1 create bloom-db
      "database_id": "PENDIENTE-EJECUTA-wrangler-d1-create",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "BUSINESS_NAME": "BLOOM",
    // Número de WhatsApp de BLOOM en formato internacional, solo dígitos (ej. 52 + 10 dígitos).
    "WHATSAPP_NUMBER": ""
  },

  // Limpieza diaria de sesiones vencidas y contadores de intentos.
  "triggers": { "crons": ["15 9 * * *"] },

  // Los registros de invocación incluyen la URL completa; se desactivan para
  // que los enlaces privados (/cuenta/TOKEN) no queden guardados en logs.
  "observability": { "enabled": false }
}
