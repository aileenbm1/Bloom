{
  "name": "bloom-cuentas",
  "version": "1.0.0",
  "description": "BLOOM · Portal de cuentas por cobrar en Cloudflare Workers + D1",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "predev": "node scripts/setup-local.mjs",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "check": "npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply bloom-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bloom-db --remote",
    "admin:create": "node scripts/create-admin.mjs",
    "secret:set": "node scripts/set-secret.mjs",
    "predeploy": "npm run typecheck",
    "deploy": "wrangler deploy && wrangler d1 migrations apply bloom-db --remote",
    "backup": "node scripts/backup.mjs",
    "tail": "wrangler tail",
    "publicar": "node scripts/publish.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261014.1",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
